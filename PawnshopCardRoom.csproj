<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>PawnshopCardRoom</AssemblyName>
    <RootNamespace>PawnshopCardRoom</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/**/*.cs" />
    <Reference Include="Assembly-CSharp" HintPath="$(GameManaged)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(GameManaged)/0Harmony.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameManaged)/UnityEngine.CoreModule.dll" Private="false" />
  </ItemGroup>
  <Target Name="CheckGameManaged" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(GameManaged)/Assembly-CSharp.dll') Or !Exists('$(GameManaged)/0Harmony.dll')"
           Text="把 GameManaged 指向游戏目录下的 Probably Stolen_Data/Managed，例如：dotnet build -c Release '-p:GameManaged=D:\Steam\steamapps\common\Probably Stolen\Probably Stolen_Data\Managed'" />
  </Target>
</Project>
